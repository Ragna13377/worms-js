{
	"name": "worms-js",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev --webpack",
		"build": "next build --webpack",
		"start": "next start",
		"lint": "biome check --staged --no-errors-on-unmatched",
		"format": "biome format --write .",
		"prisma:migrate": "npx prisma generate && npx prisma migrate dev --name init",
		"prisma:seed": "npx prisma db seed",
		"postinstall": "prisma generate",
		"predeploy": "cross-env GITHUB_ACTIONS=true npm run build",
		"deploy": "gh-pages -d out --nojekyll",
		"test": "vitest run",
		"typecheck": "tsc --noEmit --incremental false",
		"test:watch": "vitest",
		"prepare": "lefthook install"
	},
	"dependencies": {
		"@prisma/client": "^6.4.1",
		"@react-three/drei": "^10.7.9",
		"@react-three/fiber": "^9.8.1",
		"clsx": "^2.1.1",
		"next": "^16.3.8",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"styled-components": "^6.1.15",
		"tailwind-merge": "^3.0.2",
		"tailwindcss-animate": "^1.0.7",
		"three": "^0.186.1",
		"zod": "^3.24.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^22.20.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/three": "^0.186.0",
		"cross-env": "^10.1.0",
		"dotenv": "^18.0.5",
		"gh-pages": "6.1.1",
		"lefthook": "^2.1.17",
		"postcss": "^8.5.3",
		"prisma": "^6.4.1",
		"raw-loader": "^4.0.2",
		"tailwindcss": "^4",
		"typescript": "^5",
		"vitest": "^5.0.3"
	},
	"engines": {
		"node": "^22.12.0 || ^24.0.0 || >=26.0.0"
	},
	"overrides": {
		"@prisma/config": {
			"deepmerge-ts": "^8.0.0"
		}
	}
}
