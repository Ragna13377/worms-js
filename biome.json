{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!!**/node_modules",
			"!!**/.next",
			"!!**/out",
			"!!**/.terrain-tests",
			"!!public/assets",
			"!package-lock.json"
		]
	},
	"formatter": { "indentStyle": "tab", "indentWidth": 2, "lineWidth": 100, "lineEnding": "lf" },
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"jsxQuoteStyle": "single",
			"trailingCommas": "es5",
			"semicolons": "always"
		}
	},
	"css": { "parser": { "tailwindDirectives": true } },
	"linter": { "enabled": true, "rules": { "preset": "recommended" } }
}
