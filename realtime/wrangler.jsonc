{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "worms-js-realtime",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-07",
	"workers_dev": true,
	"durable_objects": {
		"bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }]
	},
	"exports": {
		"GameRoom": { "type": "durable-object", "storage": "sqlite" }
	}
}
